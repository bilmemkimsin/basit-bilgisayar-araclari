<Window x:Class="BasitBilgisayarAraclari.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BasitBilgisayarAraclari.App.Localization"
        xmlns:modules="clr-namespace:BasitBilgisayarAraclari.App.Modules"
        xmlns:viewModels="clr-namespace:BasitBilgisayarAraclari.App.ViewModels"
        Title="{loc:Loc Source='Basit Bilgisayar Araçları'}"
        Icon="Assets/CryingBabyMascot.png"
        Width="1120"
        Height="760"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>

        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <ContentPresenter HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              RecognizesAccessKey="True" />
        </ControlTemplate>

        <Style x:Key="LanguagePickerToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeSwitchButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="80" Height="40" SnapsToDevicePixels="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslation"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslation"
                                                             Storyboard.TargetProperty="X"
                                                             To="40" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Track" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20" />
                            <TextBlock x:Name="TrackSunGlyph" Text="☀" FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                       Margin="12,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="TrackMoonGlyph" Text="☾" FontFamily="Segoe UI Symbol" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,12,0" IsHitTestVisible="False" />
                            <Border x:Name="Thumb" Width="34" Height="34" Margin="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="17" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslation" X="0" />
                                </Border.RenderTransform>
                                <Grid>
                                    <TextBlock x:Name="SunThumbGlyph" Text="☀"
                                               FontFamily="Segoe UI Symbol" FontSize="17"
                                               Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MoonThumbGlyph" Text="☾"
                                               FontFamily="Segoe UI Symbol" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="TrackSunGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TrackMoonGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                                <Setter TargetName="TrackSunGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TrackMoonGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SunThumbGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MoonThumbGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
        </Style>

        <DataTemplate DataType="{x:Type modules:ToolWorkspaceViewModel}">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                <DockPanel>
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="{Binding IconBackground}" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="25"
                                   Foreground="{Binding IconForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6"
                            DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToolLabel}" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </DockPanel>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}"
                           FontSize="27" FontWeight="Bold" Margin="0,24,0,0" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}"
                           FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,11,0,0" />
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="18" Margin="0,25,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Source='SIRADAKİ GELİŞTİRME'}" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding NextStep}" Foreground="{DynamicResource InkBrush}"
                                   FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ShutdownTimerViewModel}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <DockPanel>
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="{Binding IconBackground}" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="25"
                                   Foreground="{Binding IconForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6"
                            DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToolLabel}" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </DockPanel>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}"
                           FontSize="27" FontWeight="Bold" Margin="0,24,0,0" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}"
                           FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,11,0,0" />

                <StackPanel Margin="0,25,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{loc:Loc Source='KAPATMA SÜRESİ'}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <Grid Margin="0,10,0,0" IsEnabled="{Binding IsInputEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Source='Saat'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                            <TextBox Text="{Binding HoursInput, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="5" Padding="12,10" FontSize="17" Margin="0,5,0,0"
                                     AutomationProperties.Name="{loc:Loc Source='Saat'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Source='Dakika'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                            <TextBox Text="{Binding MinutesInput, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2" Padding="12,10" FontSize="17" Margin="0,5,0,0"
                                     AutomationProperties.Name="{loc:Loc Source='Dakika'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{loc:Loc Source='Saniye'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                            <TextBox Text="{Binding SecondsInput, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2" Padding="12,10" FontSize="17" Margin="0,5,0,0"
                                     AutomationProperties.Name="{loc:Loc Source='Saniye'}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding InputValidationMessage}" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDurationValid}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="15" Margin="0,15,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDurationValid}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConfirmationSummary}" Foreground="{DynamicResource InkBrush}"
                                   FontSize="14" TextWrapping="Wrap" LineHeight="21" />
                    </Border>

                    <CheckBox Style="{StaticResource {x:Type CheckBox}}"
                              IsChecked="{Binding IsRiskAcknowledged, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsInputEnabled}" Margin="0,16,0,0"
                              AutomationProperties.Name="{loc:Loc Source='Kaydedilmemiş işler uyarısını onayla'}">
                        <TextBlock Text="{loc:Loc Source='Süre dolduğunda Windows açık uygulamaları kapatabilir. Kaydedilmemiş işlerimi kaydedip bu riski anlıyorum.'}"
                                   Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                    </CheckBox>

                    <Button Content="{loc:Loc Source='Kapatmayı planla'}" Command="{Binding ScheduleCommand}"
                            Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0"
                            Padding="18,12" FontSize="14" FontWeight="SemiBold"
                            HorizontalAlignment="Left" Margin="0,17,0,0" Cursor="Hand" />
                </StackPanel>

                <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,25,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Source='KALAN SÜRE'}" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding RemainingTimeText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="38" FontWeight="Bold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <Button Content="{loc:Loc Source='Zamanlayıcıyı iptal et'}" Command="{Binding CancelCommand}"
                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}"
                                BorderThickness="1" Padding="15,10" FontSize="13"
                                HorizontalAlignment="Left" Margin="0,15,0,0" Cursor="Hand" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                           FontSize="13" TextWrapping="Wrap" Margin="0,13,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:FileOperationViewModel}">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                <DockPanel>
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="{Binding IconBackground}" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="25"
                                   Foreground="{Binding IconForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6"
                            DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToolLabel}" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </DockPanel>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}"
                           FontSize="27" FontWeight="Bold" Margin="0,24,0,0" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}"
                           FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0" />

                <StackPanel Margin="0,23,0,0" IsEnabled="{Binding IsInputsEnabled}">
                    <TextBlock Text="{loc:Loc Source='KAYNAK DOSYALAR VE KLASÖRLER'}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Button Content="{loc:Loc Source='Arşiv ekle'}" Command="{Binding AddArchivesCommand}"
                                Padding="13,8" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Source='Klasör ekle'}" Command="{Binding AddFolderCommand}"
                                Padding="13,8" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Margin="0,10,0,0" Padding="8" Background="{DynamicResource SurfaceAltBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sources.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,3">
                                        <Button Content="{loc:Loc Source='Kaldır'}" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" DockPanel.Dock="Right"
                                                Padding="8,4" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,19,0,0" IsEnabled="{Binding IsInputsEnabled}">
                    <TextBlock Text="{loc:Loc Source='HEDEF KLASÖR'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="{loc:Loc Source='Gözat'}" Command="{Binding PickTargetCommand}"
                                DockPanel.Dock="Right" Padding="13,8" Margin="8,0,0,0" />
                        <TextBox Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{loc:Loc Source='Hedef klasör'}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Margin="0,15,0,0" IsEnabled="{Binding IsInputsEnabled}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGameModMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Loc Source='OYUN PROFİLİ'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="{loc:Loc Source='Profili kaydet'}" Command="{Binding SaveProfileCommand}"
                                DockPanel.Dock="Right" Padding="13,8" Margin="8,0,0,0" />
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" VerticalContentAlignment="Center"
                                 ToolTip="{loc:Loc Source='Profil adı'}" AutomationProperties.Name="{loc:Loc Source='Profil adı'}" />
                    </DockPanel>
                    <TextBlock Text="{loc:Loc Source='Kaydedilmiş oyun profili'}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                               FontWeight="Bold" Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name" Margin="0,5,0,0" Padding="8"
                              ToolTip="{loc:Loc Source='Kaydedilmiş oyun profili'}" />
                    <TextBlock Text="{loc:Loc Source='Mod yedekleri'}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                               FontWeight="Bold" Margin="0,10,0,0" />
                    <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                              DisplayMemberPath="Label" Margin="0,5,0,0" Padding="8"
                              ToolTip="{loc:Loc Source='Mod yedekleri'}" />
                    <Button Content="{loc:Loc Source='Seçili yedeği geri yükle'}" Command="{Binding RestoreBackupCommand}"
                            HorizontalAlignment="Left" Padding="13,8" Margin="0,8,0,0" />
                </StackPanel>

                <CheckBox Style="{StaticResource {x:Type CheckBox}}"
                          Content="{loc:Loc Source='Kaynakta tek bir üst klasör varsa atla; altındaki dosyaları hedefe yerleştir'}"
                          IsChecked="{Binding SkipSingleTopFolder}" IsEnabled="{Binding IsInputsEnabled}" Margin="0,15,0,0"
                          AutomationProperties.Name="{loc:Loc Source='Tek üst klasörü atla'}" />

                <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding IsInputsEnabled}">
                    <RadioButton Style="{StaticResource {x:Type RadioButton}}"
                                 Content="{loc:Loc Source='Çakışmada üzerine yaz'}" IsChecked="{Binding OverwriteConflicts}"
                                 GroupName="ConflictPolicy" Margin="0,0,8,8" />
                    <RadioButton Style="{StaticResource {x:Type RadioButton}}"
                                 Content="{loc:Loc Source='Çakışan yolu atla'}" IsChecked="{Binding SkipConflicts}"
                                 GroupName="ConflictPolicy" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding ConflictPolicyDescription}" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="{loc:Loc Source='Yolları önizle'}" Command="{Binding PreviewCommand}"
                            Padding="15,10" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Source='Önizlemeyi uygula'}" Command="{Binding ApplyCommand}"
                            Padding="15,10" Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <Border Margin="0,13,0,0" Padding="3" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding PreviewEntries}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MinHeight="120" MaxHeight="360"
                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Source='Hedef içindeki yol'}" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Loc Source='Kaynak'}" Binding="{Binding Sources}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Source='Bayt'}" Binding="{Binding SizeBytes}" Width="90" />
                            <DataGridTextColumn Header="{loc:Loc Source='Durum'}" Binding="{Binding ConflictDescription}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,26" LastChildFill="True">
            <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}"
                    ClipToBounds="True"
                    DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="Assets/CryingBabyMascot.png" Stretch="Uniform" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Source='Dil'}" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Grid>
                    <ToggleButton x:Name="LanguagePickerToggle"
                                  MinWidth="174" Height="44"
                                  Style="{StaticResource LanguagePickerToggleButtonStyle}"
                                  IsChecked="{Binding Settings.IsLanguagePickerOpen, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc Source='Dil seçimi'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="9"
                                    Background="{DynamicResource AccentSurfaceBrush}">
                                <TextBlock Text="{Binding Settings.SelectedLanguageBadge}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Margin="9,0,8,0"
                                       Text="{Binding Settings.SelectedLanguageDisplayName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Path Grid.Column="2" Width="9" Height="6"
                                  Data="M 0,0 L 4.5,4.5 L 9,0"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>

                    <Popup PlacementTarget="{Binding ElementName=LanguagePickerToggle}"
                           Placement="Bottom" VerticalOffset="8"
                           IsOpen="{Binding Settings.IsLanguagePickerOpen, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <Border Width="232" MaxHeight="390" Padding="10"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#080A10" BlurRadius="24"
                                                  ShadowDepth="6" Opacity="0.32" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Source='Dil seçimi'}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" FontWeight="Bold"
                                           Margin="8,5,8,9" />
                                <ScrollViewer MaxHeight="330"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Settings.Languages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LanguageOptionButtonStyle}"
                                                        Command="{Binding DataContext.Settings.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding Code}"
                                                        AutomationProperties.Name="{Binding DisplayName}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13" FontWeight="Medium"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="✓"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Margin="12,0,2,0"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock Text="{loc:Loc Source='Tema'}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ToggleButton Style="{StaticResource ThemeSwitchButtonStyle}"
                              IsThreeState="False"
                              IsChecked="{Binding Settings.IsDarkTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{loc:Loc Source='Tema'}"
                              AutomationProperties.Name="{loc:Loc Source='Tema'}" />
            </StackPanel>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Source='Basit Bilgisayar Araçları'}" Foreground="{DynamicResource InkBrush}"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Source='Küçük işler, tek yerde.'}" Foreground="{DynamicResource MutedBrush}"
                           FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid x:Name="DashboardView">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,6,0,28">
                    <TextBlock Text="{loc:Loc Source='Bugün hangi işi kısaltıyoruz?'}" Foreground="{DynamicResource InkBrush}"
                               FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="{loc:Loc Source='Aracını seç; gereksiz adımları birlikte kaldıralım.'}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,9,0,0" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Tools}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}"
                                    Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}" Margin="0,0,18,18">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="20" Padding="22"
                                        MinHeight="238">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <Border Width="48" Height="48" CornerRadius="15"
                                                    Background="{Binding IconBackground}" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding IconGlyph}" FontSize="23"
                                                           Foreground="{Binding IconForeground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="9,5"
                                                    DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ToolLabel}" FontSize="10"
                                                           FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Margin="0,19,0,20">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}"
                                                       FontSize="19" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <DockPanel Grid.Row="2">
                                            <TextBlock Text="{loc:Loc Source='ARACI AÇ'}" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="16" FontWeight="SemiBold" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid x:Name="WorkspaceView">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Command="{Binding ShowDashboardCommand}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc Source='Tüm araçlar'}" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1" Margin="0,24,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="22" Padding="34">
                        <ContentControl Content="{Binding ActiveWorkspace}" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc Source='BASİT, AMA İŞLEVSEL'}"
                       Foreground="{DynamicResource TextSubtleBrush}" FontSize="10"
                       FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{loc:Loc Source='v0.1 · Yerel araçlar'}"
                       Foreground="{DynamicResource TextSubtleBrush}" FontSize="10"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
