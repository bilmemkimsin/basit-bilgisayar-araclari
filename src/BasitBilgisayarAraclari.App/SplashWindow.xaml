<Window x:Class="BasitBilgisayarAraclari.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BasitBilgisayarAraclari.App.Localization"
        Title="{loc:Loc Source='Basit Bilgisayar Araçları'}"
        Width="500"
        Height="390"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Storyboard x:Key="SplashIntro">
            <DoubleAnimation Storyboard.TargetName="SplashPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="MascotImage"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="MascotScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.78" To="1" Duration="0:0:0.55" />
            <DoubleAnimation Storyboard.TargetName="MascotScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.78" To="1" Duration="0:0:0.55" />
            <DoubleAnimation Storyboard.TargetName="MascotFloat"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.55" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FallingTear"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.45"
                                           RepeatBehavior="2x">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="FallingTearTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="24" BeginTime="0:0:0.45"
                             Duration="0:0:0.55" RepeatBehavior="2x" />
            <DoubleAnimation Storyboard.TargetName="ProgressMarkerTransform"
                             Storyboard.TargetProperty="X"
                             From="-58" To="160" BeginTime="0:0:0.3"
                             Duration="0:0:0.72" RepeatBehavior="2x" />
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SplashIntro}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="14">
        <Border CornerRadius="28"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="32">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="24" ShadowDepth="2" Opacity="0.14" />
            </Border.Effect>
            <Grid x:Name="SplashPanel" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Width="190" Height="190" HorizontalAlignment="Center">
                    <Image x:Name="MascotImage"
                           Source="Assets/CryingBabyMascot.png"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5"
                           Opacity="0">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MascotScale" ScaleX="0.78" ScaleY="0.78" />
                                <TranslateTransform x:Name="MascotFloat" Y="18" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Path x:Name="FallingTear"
                          Data="M 9,0 C 5,6 1,11 1,16 C 1,21 4,25 9,25 C 14,25 17,21 17,16 C 17,11 13,5 9,0 Z"
                          Width="13"
                          Height="20"
                          Fill="{DynamicResource TearBrush}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,56,17,0"
                          Opacity="0">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="FallingTearTransform" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{loc:Loc Source='Basit Bilgisayar Araçları'}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="23"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBlock Grid.Row="2"
                           Text="{loc:Loc Source='Küçük işler, tek yerde.'}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0" />
                <Border Grid.Row="3"
                        Width="160"
                        Height="6"
                        Background="{DynamicResource BorderBrush}"
                        CornerRadius="3"
                        ClipToBounds="True"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                    <Border x:Name="ProgressMarker"
                            Width="58"
                            Background="{DynamicResource AccentSolidBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgressMarkerTransform" X="-58" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock Grid.Row="4"
                           Text="{loc:Loc Source='Hazırlanıyor…'}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
